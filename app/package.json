{
  "name": "limanix-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/graph.mjs && vite",
    "build": "node scripts/graph.mjs && vue-tsc --build && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.mjs",
    "test": "node scripts/graph.mjs && vue-tsc --build",
    "lint": "eslint . && prettier --check src scripts public index.html download.html catalog.html"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.108.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vue-tsc": "3.3.14"
  }
}
