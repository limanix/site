{
  "name": "limanix-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "vitepress dev",
    "prebuild": "node scripts/prepare.mjs && node scripts/check-pages.mjs pages",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "pretest": "node scripts/prepare.mjs",
    "test": "node --test scripts/test/*.test.mjs && node scripts/check-pages.mjs pages",
    "lint": "prettier --check pages .vitepress scripts",
    "format": "prettier --write pages .vitepress scripts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "mermaid": "12.2.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "vitepress": "2.0.0-alpha.20"
  }
}
